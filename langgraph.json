{
  "dependencies": ["."],
  "graphs": {
    "agent_not_deep": {
      "path": "./graph_src/agent.py:agent_not_deep"
    },
    "agent": {
      "path": "./graph_src/agent.py:make_graph"
    },
    "deepagent_demo": {
      "path": "./graph_src/deepagent_example.py:deepagent_demo"
    },
    "test_agent": {
      "path": "./graph_src/agent.py:demo_agent"
    }
  },
  "http": {
    "cors": {
      "allow_origins": [
        "http://localhost:3000",
        "http://127.0.0.1:3000",
        "http://localhost",
        "http://127.0.0.1"
      ],
      "allow_methods": ["*"],
      "allow_headers": ["*"],
      "allow_credentials": false
    },
    "configurable_headers": {
      "includes": [
        "x-model-provider",
        "x-system-prompt",
        "x-enable-local-tools",
        "x-enable-local-mcp",
        "x-mcp-server",
        "x-mcp-servers"
      ],
      "excludes": ["authorization", "x-api-key"]
    }
  },
  "auth": {
    "path": "./graph_src/auth_oauth.py:oauth_auth",
    "disable_studio_auth": false
  },
  "env": ".env",
  "image_distro": "wolfi"
}
